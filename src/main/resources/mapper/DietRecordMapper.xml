<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.DietRecordMapper">

    <resultMap id="BaseResultMap" type="com.example.entity.DietRecord">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="goods_id" property="goodsId" />
        <result column="goods_name" property="goodsName" />
        <result column="meal_type" property="mealType" />
        <result column="calories" property="calories" />
        <result column="protein" property="protein" />
        <result column="carbs" property="carbs" />
        <result column="fat" property="fat" />
        <result column="record_time" property="recordTime" />
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        select * from diet_record
        <where>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="mealType != null and mealType != ''">
                and meal_type = #{mealType}
            </if>
            <if test="recordTime != null">
                and date(record_time) = date(#{recordTime})
            </if>
        </where>
        order by record_time desc
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        select * from diet_record where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into diet_record(user_id, goods_id, goods_name, meal_type, calories, protein, carbs, fat, record_time)
        values (#{userId}, #{goodsId}, #{goodsName}, #{mealType}, #{calories}, #{protein}, #{carbs}, #{fat}, now())
    </insert>

    <update id="updateById">
        update diet_record
        <set>
            <if test="mealType != null">meal_type = #{mealType},</if>
            <if test="calories != null">calories = #{calories},</if>
            <if test="protein != null">protein = #{protein},</if>
            <if test="carbs != null">carbs = #{carbs},</if>
            <if test="fat != null">fat = #{fat},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from diet_record where id = #{id}
    </delete>

</mapper>
