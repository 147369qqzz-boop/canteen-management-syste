<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CanteenMapper">

    <resultMap id="BaseResultMap" type="com.example.entity.Canteen">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="location" property="location" />
        <result column="floors" property="floors" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        select * from canteen
        <where>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="location != null and location != ''">
                and location like concat('%', #{location}, '%')
            </if>
        </where>
        order by id asc
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        select * from canteen where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into canteen(name, location, floors, create_time)
        values (#{name}, #{location}, #{floors}, now())
    </insert>

    <update id="updateById">
        update canteen
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="location != null">location = #{location},</if>
            <if test="floors != null">floors = #{floors},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from canteen where id = #{id}
    </delete>

</mapper>
