page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.line1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price {
  color: #e05a3c;
  font-weight: bold;
}

.btn-primary {
  background: #e05a3c;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 16rpx 40rpx;
}

.btn-danger {
  background: #e05a3c;
  color: #fff;
}

.btn-outline {
  border: 2rpx solid #e05a3c;
  color: #e05a3c;
  background: #fff;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.tag-hot {
  background: #e05a3c;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-recommend {
  background: #ff6b35;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.section-title {
  display: flex;
  align-items: center;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #e05a3c;
  margin-bottom: 20rpx;
}

.section-title text {
  color: #e05a3c;
  font-weight: bold;
  font-size: 34rpx;
  margin-left: 8rpx;
}

.loading-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

.container-bottom {
  padding-bottom: 120rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0e0e0;
  color: #999;
  font-size: 48rpx;
}
