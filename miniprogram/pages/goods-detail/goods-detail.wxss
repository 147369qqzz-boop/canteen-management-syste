.page { background: #f5f5f5; padding-bottom: 40rpx; }

.detail-img-wrap { position: relative; }
.detail-img { width: 100%; height: 500rpx; }
.img-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 30rpx 20rpx; background: linear-gradient(transparent, rgba(0,0,0,0.4)); }
.rec-badge { color: #fff; font-size: 24rpx; background: #e05a3c; padding: 6rpx 16rpx; border-radius: 6rpx; }

.info-card { padding: 24rpx; margin: 20rpx; }
.info-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14rpx; }
.info-name { font-size: 38rpx; font-weight: bold; flex: 1; }
.collect-action { font-size: 26rpx; color: #999; white-space: nowrap; }
.collect-action.active { color: #e05a3c; }
.info-price-row { display: flex; align-items: baseline; gap: 20rpx; margin-bottom: 16rpx; }
.price-big { font-size: 48rpx; }
.info-meta { font-size: 24rpx; color: #999; }
.info-desc { font-size: 26rpx; color: #666; line-height: 1.6; padding: 16rpx; background: #fafafa; border-radius: 12rpx; margin-bottom: 20rpx; }

/* 评分概要 */
.score-summary {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff8f5;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.score-left { display: flex; align-items: baseline; margin-right: 16rpx; }
.score-num { font-size: 56rpx; font-weight: bold; color: #e05a3c; }
.score-unit { font-size: 24rpx; color: #e05a3c; margin-left: 4rpx; }
.score-stars-big { margin-right: 12rpx; }
.big-star { font-size: 32rpx; color: #eee; margin-right: 4rpx; }
.big-star.on { color: #ff9500; }
.big-star.half { color: #ffcc80; }
.score-count { font-size: 24rpx; color: #999; margin-left: auto; }

/* 操作区 */
.action-row { display: flex; align-items: center; gap: 12rpx; }
.stepper { display: flex; align-items: center; border: 1rpx solid #eee; border-radius: 10rpx; }
.step-btn { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 30rpx; background: #f8f8f8; color: #333; }
.step-val { width: 64rpx; text-align: center; font-size: 28rpx; }
.act-cart, .act-buy {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  border-radius: 36rpx;
  border: none;
  padding: 0;
}
.act-cart { background: #fff; color: #e05a3c; border: 2rpx solid #e05a3c; }
.act-buy { background: #e05a3c; color: #fff; }

/* 评价区 */
.comment-section { margin: 0 20rpx 20rpx; padding: 24rpx; }
.comment-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.comment-title { font-size: 32rpx; font-weight: bold; }
.comment-sort { display: flex; gap: 20rpx; }
.sort-opt { font-size: 24rpx; color: #999; }
.sort-opt.on { color: #e05a3c; font-weight: bold; }

.empty-comment { text-align: center; padding: 60rpx 0; color: #bbb; font-size: 26rpx; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }

.comment-card { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.comment-card:last-child { border-bottom: none; }
.cmt-user { display: flex; align-items: center; margin-bottom: 12rpx; }
.cmt-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }
.cmt-avatar-place { background: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.cmt-user-info { flex: 1; margin-left: 14rpx; }
.cmt-name { font-size: 26rpx; font-weight: 500; display: block; }
.cmt-stars { margin-top: 4rpx; }
.cmt-star { font-size: 24rpx; color: #eee; margin-right: 2rpx; }
.cmt-star.on { color: #ff9500; }
.cmt-time { font-size: 22rpx; color: #ccc; }
.cmt-body { font-size: 28rpx; line-height: 1.6; color: #333; margin-bottom: 10rpx; }
.cmt-footer { background: #fafafa; padding: 12rpx 16rpx; border-radius: 8rpx; }
.reply-tag { font-size: 22rpx; color: #e05a3c; margin-right: 10rpx; }
.reply-text { font-size: 24rpx; color: #666; }

.load-more { text-align: center; padding: 20rpx; color: #999; font-size: 24rpx; }

/* Modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal { width: 82%; background: #fff; border-radius: 20rpx; overflow: hidden; }
.modal-title { text-align: center; padding: 30rpx; font-size: 34rpx; font-weight: bold; }
.modal-body { padding: 0 30rpx 20rpx; }
.form-row { margin-bottom: 20rpx; }
.form-label { display: block; font-size: 28rpx; margin-bottom: 10rpx; }
.radio-item { margin-right: 30rpx; font-size: 28rpx; }
.form-textarea { width: 100%; height: 140rpx; border: 1rpx solid #eee; border-radius: 12rpx; padding: 14rpx; font-size: 26rpx; box-sizing: border-box; }
.order-summary { display: flex; justify-content: space-between; padding: 16rpx; background: #fafafa; border-radius: 10rpx; font-size: 28rpx; margin-top: 10rpx; }
.modal-ft { display: flex; border-top: 1rpx solid #eee; }
.mbtn { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 30rpx; border-radius: 0; border: none; }
.mbtn.cancel { background: #f5f5f5; color: #666; }
.mbtn.ok { background: #e05a3c; color: #fff; }
