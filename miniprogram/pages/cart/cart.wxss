.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-item:last-child {
  border-bottom: none;
}

.cart-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin: 0 16rpx;
}

.cart-info {
  flex: 1;
  min-width: 0;
}

.cart-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.price-num {
  font-size: 32rpx;
}

.cart-stepper {
  display: flex;
  align-items: center;
  margin: 0 12rpx;
}

.stepper-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.stepper-val {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}

.cart-del {
  font-size: 24rpx;
  color: #e05a3c;
  padding: 8rpx 16rpx;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 30rpx;
  color: #999;
}

.empty-tip text {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.go-buy-btn {
  margin-top: 40rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #e05a3c;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
}

.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 99;
}

.cart-total {
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.total-price {
  font-size: 36rpx;
}

.checkout-btn {
  height: 68rpx;
  line-height: 68rpx;
  background: #e05a3c;
  color: #fff;
  border-radius: 34rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  border: none;
}

.checkout-btn[disabled] {
  background: #ccc;
}

/* Modal styles - same as goods-detail */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-title {
  text-align: center;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.radio-label {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #e05a3c;
  color: #fff;
}
