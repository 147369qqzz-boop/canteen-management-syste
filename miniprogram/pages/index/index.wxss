.page { padding: 0 20rpx; }

/* Header */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 10rpx;
}
.header-logo {
  font-size: 36rpx;
  font-weight: bold;
  color: #e05a3c;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.header-search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 0 24rpx;
}
.search-icon { font-size: 28rpx; margin-right: 10rpx; }
.search-text { color: #bbb; font-size: 26rpx; }

/* Notice */
.notice-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  background: #fff7e6;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}
.notice-icon { font-size: 28rpx; margin-right: 10rpx; flex-shrink: 0; }
.notice-text { font-size: 24rpx; color: #cc6600; }

/* Categories */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx 10rpx;
  margin-bottom: 10rpx;
}
.category-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}
.cate-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #fff5f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.cate-name { font-size: 22rpx; color: #555; }

/* Carousel */
.carousel-wrap { margin-bottom: 24rpx; }
.carousel-img { width: 100%; height: 100%; border-radius: 16rpx; }

/* Section */
.section { margin-bottom: 30rpx; }
.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  flex: 1;
}
.section-title text:first-child { margin-right: 8rpx; font-size: 30rpx; }
.section-more { font-size: 24rpx; color: #999; }

/* Countdown */
.countdown { display: flex; align-items: center; margin-right: 20rpx; font-size: 22rpx; color: #e05a3c; }
.cd-item {
  background: #e05a3c;
  color: #fff;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin: 0 2rpx;
}

/* Flash */
.flash-scroll { white-space: nowrap; }
.flash-card {
  display: inline-block;
  width: 240rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.flash-img { width: 240rpx; height: 180rpx; }
.flash-info { padding: 10rpx 14rpx; }
.flash-name { font-size: 26rpx; margin-bottom: 6rpx; }
.flash-price { display: flex; align-items: baseline; gap: 8rpx; }
.flash-original { font-size: 20rpx; color: #ccc; text-decoration: line-through; }

/* Rank */
.rank-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f8f8f8;
}
.rank-item:last-child { border-bottom: none; }
.rank-num {
  width: 50rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #999;
  flex-shrink: 0;
}
.rank-num.rank-1,
.rank-num.rank-2,
.rank-num.rank-3 { font-size: 36rpx; }
.rank-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin: 0 16rpx;
}
.rank-info { flex: 1; min-width: 0; }
.rank-name { font-size: 28rpx; margin-bottom: 4rpx; }
.rank-meta { font-size: 22rpx; color: #aaa; }
.rank-price { font-size: 32rpx; flex-shrink: 0; margin-left: 10rpx; }

/* Recommend */
.recommend-scroll { white-space: nowrap; }
.recommend-card {
  display: inline-block;
  width: 280rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
}
.recommend-img { width: 280rpx; height: 210rpx; }
.recommend-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: #e05a3c;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.recommend-info { padding: 14rpx 16rpx; white-space: normal; }
.recommend-name { font-size: 28rpx; font-weight: 500; margin-bottom: 6rpx; }
.recommend-desc { font-size: 22rpx; color: #999; margin-bottom: 10rpx; line-height: 1.4; }
.recommend-bottom { display: flex; justify-content: space-between; align-items: center; }
.recommend-sale { font-size: 20rpx; color: #bbb; }

/* New */
.waterfall { display: flex; flex-wrap: wrap; justify-content: space-between; }
.new-card {
  width: 48%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.new-img { width: 100%; height: 220rpx; }
.new-info { padding: 12rpx 16rpx; }
.new-name { font-size: 28rpx; margin-bottom: 8rpx; }
.new-bottom { display: flex; justify-content: space-between; align-items: center; }
.new-tag {
  font-size: 20rpx;
  background: #e8fce8;
  color: #34c759;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
