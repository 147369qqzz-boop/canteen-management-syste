.page { padding: 0 20rpx; }

.profile-card {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx;
  background: linear-gradient(135deg, #e05a3c, #ff7b5a);
  border-radius: 20rpx;
  margin: 20rpx 0 24rpx;
}
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; border: 3rpx solid rgba(255,255,255,0.5); }
.avatar-place { background: rgba(255,255,255,0.3); display: flex; align-items: center; justify-content: center; font-size: 44rpx; color: #fff; }
.profile-info { flex: 1; margin-left: 24rpx; }
.profile-name { font-size: 36rpx; font-weight: bold; color: #fff; margin-bottom: 6rpx; }
.profile-account { font-size: 26rpx; color: rgba(255,255,255,0.85); }
.login-btn, .edit-btn {
  font-size: 26rpx;
  color: #fff;
  border: 2rpx solid #fff;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  background: transparent;
}
.edit-btn { padding: 10rpx 20rpx; }

.order-quick { padding: 0; margin-bottom: 24rpx; }
.quick-head {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}
.quick-title { font-size: 30rpx; font-weight: bold; }
.quick-more { font-size: 24rpx; color: #999; }
.quick-tabs {
  display: flex;
  padding: 20rpx 0;
}
.quick-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}
.tab-icon { font-size: 40rpx; margin-bottom: 6rpx; }
.tab-label { font-size: 22rpx; color: #666; }

.menu-group { margin-bottom: 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f8f8f8;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 28rpx; }
.menu-arrow { font-size: 30rpx; color: #ccc; }

.logout-wrap { text-align: center; margin: 40rpx 0; }
.logout-btn {
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #e05a3c;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid #e05a3c;
}
