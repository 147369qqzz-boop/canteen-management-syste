<view class="container">
  <view class="section-header" wx:if="{{tableData.length > 0}}">
    <text>我收藏的菜品（{{total}}）</text>
  </view>

  <view wx:if="{{tableData.length > 0}}">
    <view class="collect-grid">
      <view wx:for="{{tableData}}" wx:key="id" class="collect-item"
            bindtap="goDetail" data-id="{{item.goodsId}}">
        <image src="{{item.goodsImg}}" mode="aspectFill" class="collect-img"/>
        <view class="collect-info">
          <view class="line1 collect-name">{{item.goodsName}}</view>
          <view class="collect-bottom">
            <view class="price">¥<text class="price-num">{{item.goodsPrice}}</text></view>
            <button class="cancel-btn" catchtap="cancelCollect" data-id="{{item.id}}">取消收藏</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="loading-more" bindtap="loadMore">加载更多</view>
    <view wx:else class="loading-more">— 没有更多了 —</view>
  </view>

  <view wx:else class="empty-tip">暂无收藏</view>
</view>
