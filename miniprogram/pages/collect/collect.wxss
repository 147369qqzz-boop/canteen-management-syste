.section-header {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.collect-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.collect-item {
  width: 48%;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.collect-img {
  width: 100%;
  height: 260rpx;
}

.collect-info {
  padding: 12rpx;
}

.collect-name {
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.collect-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-num {
  font-size: 32rpx;
}

.cancel-btn {
  height: 48rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  color: #e05a3c;
  border: 1rpx solid #e05a3c;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 12rpx;
}
