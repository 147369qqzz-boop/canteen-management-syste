<view class="container">
  <view class="card password-card">
    <view class="section-title">修改密码</view>

    <view class="form-item">
      <text class="form-label">原密码</text>
      <input class="form-input" password placeholder="请输入原密码"
             value="{{form.oldPassword}}" bindinput="onInput" data-field="oldPassword"/>
    </view>

    <view class="form-item">
      <text class="form-label">新密码</text>
      <input class="form-input" password placeholder="请输入新密码"
             value="{{form.newPassword}}" bindinput="onInput" data-field="newPassword"/>
    </view>

    <view class="form-item">
      <text class="form-label">确认新密码</text>
      <input class="form-input" password placeholder="请确认新密码"
             value="{{form.confirmPassword}}" bindinput="onInput" data-field="confirmPassword"/>
    </view>

    <button class="save-btn" bindtap="save">确认修改</button>
  </view>
</view>
