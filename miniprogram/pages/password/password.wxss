.password-card {
  padding: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: #333;
}

.form-input {
  height: 80rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.save-btn {
  height: 80rpx;
  line-height: 80rpx;
  background: #e05a3c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
  margin-top: 40rpx;
}
