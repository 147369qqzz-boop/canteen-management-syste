.page { padding: 20rpx; }

.search-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: #fff;
  padding: 0 30rpx;
  font-size: 28rpx;
}
.search-btn {
  height: 72rpx;
  line-height: 72rpx;
  background: #e05a3c;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  border: none;
}

.cate-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.cate-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  background: #fff;
  margin-right: 12rpx;
}
.cate-tag.on { background: #e05a3c; color: #fff; }

.sort-bar {
  display: flex;
  gap: 30rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}
.sort-item {
  font-size: 26rpx;
  color: #999;
  position: relative;
}
.sort-item.on { color: #e05a3c; font-weight: bold; }
.sort-item.up::after { content: '↑'; font-size: 20rpx; margin-left: 4rpx; }
.sort-item.down::after { content: '↓'; font-size: 20rpx; margin-left: 4rpx; }

.goods-list { display: flex; flex-wrap: wrap; justify-content: space-between; }
.goods-card {
  width: 49%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.goods-img { width: 100%; height: 260rpx; }
.goods-body { padding: 14rpx 16rpx; }
.goods-name { font-size: 28rpx; font-weight: 500; margin-bottom: 4rpx; }
.goods-desc { font-size: 22rpx; color: #aaa; margin-bottom: 10rpx; line-height: 1.4; }
.goods-footer { display: flex; justify-content: space-between; align-items: center; }
.price-lg { font-size: 34rpx; }
.goods-meta { display: flex; align-items: center; gap: 12rpx; font-size: 20rpx; color: #bbb; }
.add-cart {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #e05a3c;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.load-more { text-align: center; padding: 20rpx; color: #999; font-size: 24rpx; }
.load-more.done { color: #ddd; }
.empty { text-align: center; padding: 100rpx 0; color: #bbb; font-size: 28rpx; }
