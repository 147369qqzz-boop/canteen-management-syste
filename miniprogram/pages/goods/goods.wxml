<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索菜品..." value="{{keyword}}"
           bindinput="onInput" bindconfirm="doSearch" confirm-type="search"/>
    <button class="search-btn" bindtap="doSearch">搜索</button>
  </view>

  <!-- 分类横向滚动 -->
  <scroll-view scroll-x class="cate-bar">
    <text class="cate-tag {{!categoryId ? 'on' : ''}}" bindtap="pickCate" data-id="">全部</text>
    <text wx:for="{{categoryList}}" wx:key="id"
          class="cate-tag {{categoryId === item.id ? 'on' : ''}}"
          bindtap="pickCate" data-id="{{item.id}}">{{item.name}}</text>
  </scroll-view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <text class="sort-item {{sortType === 'default' ? 'on' : ''}}" bindtap="setSort" data-type="default">综合</text>
    <text class="sort-item {{sortType === 'sales' ? 'on' : ''}}" bindtap="setSort" data-type="sales">销量</text>
    <text class="sort-item {{sortType === 'price' ? 'on' : ''}} {{sortType === 'price' ? (sortOrder === 'asc' ? 'up' : 'down') : ''}}"
          bindtap="setSort" data-type="price">价格</text>
  </view>

  <!-- 菜品列表 -->
  <view wx:if="{{list.length > 0}}" class="goods-list">
    <view wx:for="{{list}}" wx:key="id" class="goods-card"
          bindtap="goDetail" data-id="{{item.id}}">
      <image src="{{item.img}}" mode="aspectFill" class="goods-img"/>
      <view class="goods-body">
        <view class="line1 goods-name">{{item.name}}</view>
        <view class="goods-desc line2">{{item.description || '美味可口，等你来尝'}}</view>
        <view class="goods-footer">
          <view class="price">¥<text class="price-lg">{{item.price}}</text></view>
          <view class="goods-meta">
            <text>已售{{item.saleCount}}</text>
            <text class="add-cart" catchtap="quickBuy" data-id="{{item.id}}">+</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">{{loading ? '加载中...' : '加载更多'}}</view>
    <view wx:else class="load-more done">— 全部加载完毕 —</view>
  </view>

  <view wx:else class="empty">暂无菜品</view>
</view>
