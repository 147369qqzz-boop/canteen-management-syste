.login-container {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #2e3143;
  padding: 40rpx;
}

.login-box {
  width: 100%;
  padding: 60rpx 40rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 0 20rpx rgba(255,255,255,0.1);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 50rpx;
  color: #0c9c7a;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-input {
  height: 88rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.register-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #0c9c7a;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
  margin-top: 10rpx;
}

.login-link {
  text-align: right;
  font-size: 26rpx;
  color: #666;
  margin-top: 24rpx;
}
