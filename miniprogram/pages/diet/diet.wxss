.page { padding: 12px; background: #f5f5f5; min-height: 100vh; }

.card {
  background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
}
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.card-title { font-size: 17px; font-weight: 600; }
.card-edit { font-size: 14px; color: #e05a3c; }

.goal-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.goal-tag { font-size: 14px; padding: 6px 16px; border-radius: 8px; font-weight: 600; }
.tag-danger { background: #fbe9e7; color: #c62828; }
.tag-success { background: #e8f5e9; color: #2e7d32; }
.tag-info { background: #e3f2fd; color: #1565c0; }
.goal-nums { display: flex; gap: 16px; flex-wrap: wrap; }
.gnum { text-align: center; }
.gn-val { font-size: 20px; font-weight: 700; color: #333; }
.gn-unit { font-size: 11px; color: #999; margin-left: 2px; }

.no-goal { text-align: center; padding: 24px 16px; color: #999; }

.summary-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.s-item { flex: 1 1 45%; min-width: 45%; padding: 10px; }
.s-item.over { background: #fff5f5; border-radius: 8px; }
.s-label { font-size: 13px; color: #666; }
.s-val { font-size: 14px; font-weight: 600; margin: 4px 0 6px; }
.s-item.over .s-val { color: #f56c6c; }
.s-warn { font-size: 11px; color: #f56c6c; }
progress { width: 100%; }

.tips { margin-top: 14px; padding: 12px; background: #fefce8; border-radius: 8px; border-left: 4px solid #eab308; }
.tips-title { font-weight: 600; font-size: 14px; display: block; margin-bottom: 4px; }

.meal-picker {
  padding: 8px 14px; background: #f5f5f5; border-radius: 8px;
  font-size: 14px; margin-bottom: 10px; display: inline-block;
}

.rec-item { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
.rec-info { flex: 1; }
.rec-name { font-size: 15px; font-weight: 500; }
.rec-meta { font-size: 12px; color: #999; margin-top: 2px; display: flex; gap: 8px; }
.rec-time { font-size: 11px; color: #bbb; margin-top: 2px; }
.rec-del { font-size: 13px; color: #f56c6c; padding: 4px 8px; }
.empty-row { text-align: center; color: #999; padding: 16px; }

.chart-row { display: flex; gap: 4px; align-items: flex-end; justify-content: space-around; padding-top: 10px; }
.bar-item { flex: 1; text-align: center; }
.bar-col { display: flex; flex-direction: column; align-items: center; }
.bar-fill { width: 24px; background: #e05a3c; border-radius: 4px 4px 0 0; transition: height 0.3s; }
.bar-val { font-size: 10px; color: #999; margin-top: 2px; }
.bar-label { font-size: 11px; color: #666; margin-top: 4px; }

/* Modal */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.modal-content {
  width: 85%; max-width: 380px; background: #fff; border-radius: 14px; padding: 20px;
}
.modal-title { font-size: 17px; font-weight: 600; margin-bottom: 16px; text-align: center; }
.form-row { display: flex; align-items: center; margin-bottom: 12px; }
.form-label { width: 120px; font-size: 14px; color: #333; }
.form-input { flex: 1; border: 1px solid #ddd; border-radius: 6px; padding: 6px 10px; font-size: 14px; }
.picker-inline { padding: 6px 14px; background: #f5f5f5; border-radius: 6px; font-size: 14px; }
.rec-preview { text-align: center; font-size: 13px; color: #666; padding: 8px 0; }
.modal-btns { display: flex; gap: 12px; margin-top: 16px; }
.modal-btns button { flex: 1; border-radius: 8px; font-size: 15px; padding: 10px; }
.btn-cancel { background: #f5f5f5; color: #333; }
.btn-ok { background: #e05a3c; color: #fff; }
