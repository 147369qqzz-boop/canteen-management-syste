.recharge-card {
  padding: 24rpx;
}

.recharge-header {
  margin-bottom: 20rpx;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.date-picker {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  min-width: 240rpx;
}

.query-btn {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: none;
  background: #e05a3c;
  color: #fff;
}

.query-btn.reset {
  background: #f5f5f5;
  color: #666;
}

.balance-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.balance-num {
  font-size: 32rpx;
}

.recharge-btn {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  background: #e05a3c;
  color: #fff;
  border-radius: 28rpx;
  padding: 0 24rpx;
  border: none;
  margin-left: auto;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-type {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.record-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.record-money {
  font-size: 32rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-title {
  text-align: center;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  height: 80rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.radio-label {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.modal-btn.cancel { background: #f5f5f5; color: #666; }
.modal-btn.confirm { background: #e05a3c; color: #fff; }
