.search-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.search-input {
  width: 200rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: #fff;
  padding: 0 16rpx;
  font-size: 24rpx;
  border: 1rpx solid #eee;
}

.search-btn, .reset-btn {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: none;
}

.search-btn {
  background: #e05a3c;
  color: #fff;
}

.reset-btn {
  background: #f5f5f5;
  color: #666;
}

.order-card {
  padding: 0;
  margin-bottom: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.status-pending { background: #fff2de; color: #ff9500; }
.status-delivering { background: #e8f4ff; color: #007aff; }
.status-shipped { background: #e8f4ff; color: #007aff; }
.status-completed { background: #e8fce8; color: #34c759; }
.status-cancelled { background: #fde8e8; color: #e05a3c; }

.order-detail {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.detail-info {
  flex: 1;
  min-width: 0;
}

.detail-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.comment-btn {
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  background: #34c759;
  color: #fff;
  border-radius: 8rpx;
  padding: 0 16rpx;
  border: none;
}

.order-footer {
  padding: 16rpx 20rpx;
}

.order-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.order-total {
  font-size: 30rpx;
}

.order-meta {
  margin-left: 16rpx;
}

.order-address, .order-deliver {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.order-actions {
  text-align: right;
  margin-top: 12rpx;
}

.action-btn {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  border: none;
  margin-left: 12rpx;
}

.action-btn.cancel {
  background: #fff;
  color: #e05a3c;
  border: 1rpx solid #e05a3c;
}

.action-btn.confirm {
  background: #e05a3c;
  color: #fff;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-title {
  text-align: center;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.star-rating {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 48rpx;
  color: #ddd;
}

.star.on {
  color: #ff9500;
}

.score-hint {
  display: block;
  font-size: 24rpx;
  color: #e05a3c;
  margin-top: 8rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  color: #666;
}

.tag.on {
  background: #fff0eb;
  color: #e05a3c;
  border: 1rpx solid #e05a3c;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 6rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.modal-btn.cancel { background: #f5f5f5; color: #666; }
.modal-btn.confirm { background: #e05a3c; color: #fff; }
