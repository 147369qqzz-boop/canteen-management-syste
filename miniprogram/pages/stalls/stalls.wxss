.page { padding: 12px; background: #f5f5f5; min-height: 100vh; }

.filter-bar {
  display: flex; gap: 10px; margin-bottom: 12px;
  background: #fff; padding: 10px 14px; border-radius: 10px;
}
.picker-box {
  padding: 6px 14px; background: #f5f5f5; border-radius: 8px;
  font-size: 14px; color: #333;
}
.status-toggle {
  display: flex; gap: 6px; font-size: 13px; color: #999; margin-left: auto;
}
.status-toggle text { padding: 4px 12px; border-radius: 6px; }
.status-toggle text.active { background: #e05a3c; color: #fff; }

.stall-card {
  background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
}
.stall-header { display: flex; gap: 12px; align-items: center; }
.stall-avatar { width: 48px; height: 48px; border-radius: 10px; flex-shrink: 0; }
.avatar-place { background: #eee; }
.stall-info { flex: 1; min-width: 0; }
.stall-name { font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
.stall-addr { font-size: 12px; color: #999; margin-top: 2px; }
.stall-meta { font-size: 12px; color: #666; margin-top: 4px; display: flex; gap: 12px; }

.tag { font-size: 11px; padding: 2px 8px; border-radius: 4px; }
.tag-on { background: #e8f5e9; color: #2e7d32; }
.tag-off { background: #fbe9e7; color: #c62828; }

.goods-row { display: flex; gap: 8px; margin-top: 12px; overflow-x: auto; }
.goods-mini {
  min-width: 130px; border: 1px solid #eee; border-radius: 8px;
  overflow: hidden; flex-shrink: 0;
}
.goods-img { width: 130px; height: 90px; }
.no-img { background: #f5f5f5; }
.goods-text { padding: 6px 8px; }
.g-name { font-size: 13px; font-weight: 500; }
.g-price { font-size: 14px; font-weight: 700; color: #e05a3c; margin-top: 2px; }
.g-nutr { font-size: 10px; color: #999; margin-top: 2px; }
.g-score { font-size: 11px; color: #f39c12; }
.star { margin-right: 2px; }

.stall-footer { text-align: right; margin-top: 10px; }
.btn-more { font-size: 13px; color: #e05a3c; }
