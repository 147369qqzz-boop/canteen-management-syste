.search-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.search-input {
  width: 200rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: #fff;
  padding: 0 16rpx;
  font-size: 24rpx;
  border: 1rpx solid #eee;
}

.search-btn, .reset-btn {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: none;
}

.search-btn { background: #e05a3c; color: #fff; }
.reset-btn { background: #f5f5f5; color: #666; }

.comment-item {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.comment-row {
  display: flex;
}

.comment-goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.comment-info {
  flex: 1;
  min-width: 0;
}

.comment-goods-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #007aff;
  margin-bottom: 4rpx;
}

.comment-order-no {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.comment-stars {
  margin-bottom: 6rpx;
}

.star {
  font-size: 28rpx;
  color: #ddd;
}

.star.on { color: #ff9500; }

.score-text {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.comment-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #bbb;
}

.comment-actions {
  text-align: right;
  margin-top: 12rpx;
}

.action-btn {
  display: inline-block;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  border: none;
  margin-left: 12rpx;
}

.action-btn.edit {
  background: #e05a3c;
  color: #fff;
}

.action-btn.del {
  background: #fff;
  color: #e05a3c;
  border: 1rpx solid #e05a3c;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-title {
  text-align: center;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.star-rating {
  display: flex;
  gap: 8rpx;
}

.star-rating .star {
  font-size: 48rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.modal-btn.cancel { background: #f5f5f5; color: #666; }
.modal-btn.confirm { background: #e05a3c; color: #fff; }
