.login-container {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #2e3143, #3a3f55);
  padding: 40rpx;
}

.login-box {
  width: 100%;
  padding: 60rpx 50rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.95);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
}

.logo-area {
  text-align: center;
  margin-bottom: 50rpx;
}

.logo-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.welcome-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #1e2f3e;
  margin-bottom: 10rpx;
}

.slogan {
  font-size: 26rpx;
  color: #999;
}

.login-form {
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-input {
  height: 88rpx;
  border-radius: 44rpx;
  background: #f5f5f5;
  padding: 0 32rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
}

.picker-input {
  line-height: 88rpx;
  color: #333;
}

.login-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #f38a5e, #e05a3c);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 10rpx;
}

.register-link {
  text-align: right;
  font-size: 26rpx;
  color: #666;
}
